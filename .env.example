# Hugging Face token used by /api/generate to call FLUX.1-schnell.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Supabase project URL. Example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-only Supabase secret key used by API routes to upload images and insert rows.
# In Supabase Dashboard, find or create this under Settings > API Keys.
# Never expose this in client code and never commit a real value.
SUPABASE_SECRET_KEY=

# Storage bucket created by supabase/schema.sql.
# Leave as pixel-generations unless you changed the SQL/schema.
SUPABASE_STORAGE_BUCKET=pixel-generations

# Optional fallback read by lib/supabaseAdmin.ts when SUPABASE_URL is unset.
# Not required for the current server-only implementation.
NEXT_PUBLIC_SUPABASE_URL=

# Optional public browser key for future client-side Supabase usage.
# Not required for the current server-only generation upload flow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback also supported by lib/supabaseAdmin.ts.
# Prefer SUPABASE_SECRET_KEY for new Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=
